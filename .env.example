# Copy to .env to override the local defaults used by docker-compose.yml.
# Never commit .env - it is git-ignored.

# --- Database (local container only) ---
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=55432
RABBITMQ_UI_HOST_PORT=15672

# --- Auth (local HS256 secrets; Azure uses Entra ID + managed identity) ---
OPERATOR_JWT_SECRET=change-me-operator-secret-at-least-32-bytes
SERVICE_JWT_SECRET=change-me-service-secret-at-least-32-bytes
ENABLE_DEV_TOKEN_ENDPOINT=true
SEED_DEMO_DATA=true

# --- Ingestion ---
INGESTION_DEDUP_WINDOW_SECONDS=60

# --- Triage agent model ---
# mock (default, no key) | openai | azure_openai
AGENT_MODEL_PROVIDER=mock
# normal | invalid_json | invalid_schema | low_confidence | hallucinate_runbook | outage | rate_limited | timeout | tool_loop
AGENT_MOCK_BEHAVIOUR=normal

# OpenAI
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AGENT_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AGENT_AZURE_OPENAI_DEPLOYMENT=
AGENT_AZURE_OPENAI_API_KEY=
